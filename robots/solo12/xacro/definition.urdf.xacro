<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Solo 12 quadruped — ODRI ROS2 Gazebo simulation model.

    Kinematics and inertia taken verbatim from the official ODRI source:
      https://github.com/open-dynamic-robot-initiative/robot_properties_solo

    Meshes are stored locally in:
      hidro_robots/robots/solo12/meshes/

    Joint order in the ODRI plugin MUST match solo12.yaml safe_configuration:
      [FL_HAA, FL_HFE, FL_KFE,
       FR_HAA, FR_HFE, FR_KFE,
       HL_HAA, HL_HFE, HL_KFE,
       HR_HAA, HR_HFE, HR_KFE]

    Safe configuration (from solo12.yaml):
      FL / FR : HAA = 0.0,  HFE = +0.8, KFE = -1.6  rad
      HL / HR : HAA = 0.0,  HFE = -0.8, KFE = +1.6  rad
  -->

  <!-- ════════════════════════════════════════════════════════
       LEG MACRO
       All joint origins and inertia values come directly from
       the official robot_properties_solo xacro/leg.xacro.
       ════════════════════════════════════════════════════════
       params (all varying quantities passed explicitly):
         prefix           — FL | FR | HL | HR
         haa_x, haa_y     — HAA joint origin from base_link
         hfe_x, hfe_y     — HFE joint origin from SHOULDER link
         kfe_y            — KFE joint y-offset from UPPER_LEG
         foot_y           — ANKLE joint y-offset from LOWER_LEG
         shoulder_mesh    — STL filename for the shoulder link
         shoulder_vis_x   — shoulder visual x-offset (±0.0195 m)
         sh_cx,sh_cy,sh_cz — shoulder inertial COM
         sh_ixy, sh_ixz   — shoulder off-diagonal inertia terms
         upper_mesh       — STL filename for the upper leg
         up_cx,up_cy      — upper leg inertial COM (x,y; z=-0.07838230)
         up_ixz, up_iyz   — upper leg off-diagonal inertia
         lower_mesh       — STL filename for the lower leg
         lo_cy            — lower leg inertial COM y (z=-0.07003876)
         lo_iyz           — lower leg off-diagonal inertia
  -->
  <xacro:macro name="solo12_leg"
               params="prefix
                       haa_x haa_y
                       hfe_x hfe_y
                       kfe_y
                       foot_y
                       shoulder_mesh  shoulder_vis_x
                       sh_cx sh_cy sh_cz  sh_ixy sh_ixz
                       upper_mesh  up_cx up_cy  up_ixz up_iyz
                       lower_mesh  lo_cy  lo_iyz">

    <!-- SHOULDER link (between HAA and HFE) -->
    <link name="${prefix}_SHOULDER">
      <inertial>
        <origin xyz="${sh_cx} ${sh_cy} ${sh_cz}" rpy="0 0 0"/>
        <mass value="0.14196048"/>
        <inertia ixx="0.00002802" ixy="${sh_ixy}"  ixz="${sh_ixz}"
                                  iyy="0.00038264" iyz="0.0"
                                                   izz="0.00038050"/>
      </inertial>
      <visual>
        <origin xyz="${shoulder_vis_x} 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/${shoulder_mesh}"/>
        </geometry>
        <material name="solo_grey"><color rgba="0.8 0.8 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="${shoulder_vis_x} 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/${shoulder_mesh}"/>
        </geometry>
      </collision>
    </link>

    <!-- HAA: Hip Abduction/Adduction — rotates around x -->
    <joint name="${prefix}_HAA" type="revolute">
      <parent link="base_link"/>
      <child  link="${prefix}_SHOULDER"/>
      <origin xyz="${haa_x} ${haa_y} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit effort="1000" lower="-10" upper="10" velocity="1000"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- UPPER LEG link (between HFE and KFE) -->
    <link name="${prefix}_UPPER_LEG">
      <inertial>
        <origin xyz="${up_cx} ${up_cy} -0.07838230" rpy="0 0 0"/>
        <mass value="0.14737324"/>
        <inertia ixx="0.00041540" ixy="0.0"      ixz="${up_ixz}"
                                  iyy="0.00041637" iyz="${up_iyz}"
                                                   izz="0.00002982"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/${upper_mesh}"/>
        </geometry>
        <material name="solo_grey"><color rgba="0.8 0.8 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/${upper_mesh}"/>
        </geometry>
      </collision>
    </link>

    <!-- HFE: Hip Flexion/Extension — rotates around y -->
    <joint name="${prefix}_HFE" type="revolute">
      <parent link="${prefix}_SHOULDER"/>
      <child  link="${prefix}_UPPER_LEG"/>
      <origin xyz="${hfe_x} ${hfe_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="1000" lower="-10" upper="10" velocity="1000"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- LOWER LEG link (between KFE and ANKLE) -->
    <link name="${prefix}_LOWER_LEG">
      <inertial>
        <origin xyz="0.0 ${lo_cy} -0.07003876" rpy="0 0 0"/>
        <mass value="0.02318294"/>
        <inertia ixx="0.00008508" ixy="0.0"      ixz="0.0"
                                  iyy="0.00008580" iyz="${lo_iyz}"
                                                   izz="0.00000139"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/${lower_mesh}"/>
        </geometry>
        <material name="solo_grey"><color rgba="0.8 0.8 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/${lower_mesh}"/>
        </geometry>
      </collision>
    </link>

    <!-- KFE: Knee Flexion/Extension — rotates around y -->
    <joint name="${prefix}_KFE" type="revolute">
      <parent link="${prefix}_UPPER_LEG"/>
      <child  link="${prefix}_LOWER_LEG"/>
      <origin xyz="0 ${kfe_y} -0.16" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="1000" lower="-10" upper="10" velocity="1000"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- FOOT link — dummy frame at the tip of the lower leg -->
    <link name="${prefix}_FOOT">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0"
                           iyy="0.0" iyz="0.0"
                                     izz="0.0"/>
      </inertial>
    </link>

    <!-- ANKLE: fixed joint at foot tip -->
    <joint name="${prefix}_ANKLE" type="fixed">
      <parent link="${prefix}_LOWER_LEG"/>
      <child  link="${prefix}_FOOT"/>
      <origin xyz="0 ${foot_y} -0.16" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo contact properties on the lower leg (ground contact surface) -->
    <gazebo reference="${prefix}_LOWER_LEG">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
    </gazebo>

  </xacro:macro>


  <!-- ════════════════════════════════════════════════════════
       SOLO 12 ROBOT MACRO
       ════════════════════════════════════════════════════════ -->
  <xacro:macro name="solo12" params="simulation event_based_sim">

    <!-- ── Base link ──────────────────────────────────────────────────── -->
    <link name="base_link">
      <inertial>
        <origin xyz="-0.00082966 0.00000105 -0.00060210" rpy="0 0 0"/>
        <mass value="1.25123725"/>
        <inertia ixx="0.00266220" ixy="-0.00003684" ixz="-0.00001716"
                                  iyy="0.01388510"  iyz="-0.00000009"
                                                    izz="0.01605370"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/solo_12_base.stl"/>
        </geometry>
        <material name="solo_grey"><color rgba="0.8 0.8 0.8 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hidro_robots/robots/solo12/meshes/solo_12_base.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- ── Legs ───────────────────────────────────────────────────────── -->
    <!--
      All geometry values from robot_properties_solo/resources/xacro/leg.xacro:
        base_2_HAA_x = 0.21410 m    base_2_HAA_y = 0.08750 m
        HAA_2_HFE_x  = 0.01950 m    HAA_2_HFE_y  = 0.01400 m
        HFE_2_KFE_y  = 0.03745 m    HFE_2_KFE_z  = 0.16000 m  (in joint z)
        KFE_2_FOOT_y = 0.00900 m    KFE_2_FOOT_z = 0.16000 m  (in joint z)
    -->

    <!-- Front-Left -->
    <xacro:solo12_leg prefix="FL"
      haa_x=" 0.21410" haa_y=" 0.08750"
      hfe_x="-0.01950" hfe_y=" 0.01400"
      kfe_y=" 0.03745"  foot_y=" 0.00900"
      shoulder_mesh="solo12_hip_fe_fl.stl"  shoulder_vis_x=" 0.01950"
      sh_cx="-0.09407251" sh_cy="-0.00438935" sh_cz=" 0.00001384"
      sh_ixy=" 0.00003687" sh_ixz="-0.00000009"
      upper_mesh="solo_upper_leg_left_side.stl"
      up_cx=" 0.00001530" up_cy=" 0.01767640"
      up_ixz=" 0.00000010" up_iyz="-0.00004589"
      lower_mesh="solo_lower_leg_v2_left_side.stl"
      lo_cy=" 0.00776716" lo_iyz="-0.00000200"/>

    <!-- Front-Right -->
    <xacro:solo12_leg prefix="FR"
      haa_x=" 0.21410" haa_y="-0.08750"
      hfe_x="-0.01950" hfe_y="-0.01400"
      kfe_y="-0.03745"  foot_y="-0.00900"
      shoulder_mesh="solo12_hip_fe_fr.stl"  shoulder_vis_x=" 0.01950"
      sh_cx="-0.09407251" sh_cy=" 0.00438935" sh_cz="-0.00001384"
      sh_ixy="-0.00003687" sh_ixz=" 0.00000009"
      upper_mesh="solo_upper_leg_right_side.stl"
      up_cx="-0.00001530" up_cy="-0.01767640"
      up_ixz="-0.00000010" up_iyz=" 0.00004589"
      lower_mesh="solo_lower_leg_v2_right_side.stl"
      lo_cy="-0.00776716" lo_iyz=" 0.00000200"/>

    <!-- Hind-Left -->
    <xacro:solo12_leg prefix="HL"
      haa_x="-0.21410" haa_y=" 0.08750"
      hfe_x=" 0.01950" hfe_y=" 0.01400"
      kfe_y=" 0.03745"  foot_y=" 0.00900"
      shoulder_mesh="solo12_hip_fe_hl.stl"  shoulder_vis_x="-0.01950"
      sh_cx=" 0.09407251" sh_cy="-0.00438935" sh_cz="-0.00001384"
      sh_ixy="-0.00003687" sh_ixz="-0.00000009"
      upper_mesh="solo_upper_leg_left_side.stl"
      up_cx=" 0.00001530" up_cy=" 0.01767640"
      up_ixz=" 0.00000010" up_iyz="-0.00004589"
      lower_mesh="solo_lower_leg_v2_left_side.stl"
      lo_cy=" 0.00776716" lo_iyz="-0.00000200"/>

    <!-- Hind-Right -->
    <xacro:solo12_leg prefix="HR"
      haa_x="-0.21410" haa_y="-0.08750"
      hfe_x=" 0.01950" hfe_y="-0.01400"
      kfe_y="-0.03745"  foot_y="-0.00900"
      shoulder_mesh="solo12_hip_fe_hr.stl"  shoulder_vis_x="-0.01950"
      sh_cx=" 0.09407251" sh_cy=" 0.00438935" sh_cz=" 0.00001384"
      sh_ixy=" 0.00003687" sh_ixz=" 0.00000009"
      upper_mesh="solo_upper_leg_right_side.stl"
      up_cx="-0.00001530" up_cy="-0.01767640"
      up_ixz="-0.00000010" up_iyz=" 0.00004589"
      lower_mesh="solo_lower_leg_v2_right_side.stl"
      lo_cy="-0.00776716" lo_iyz=" 0.00000200"/>

    <!-- ── ODRI Gazebo Plugin ─────────────────────────────────────────── -->
    <!--
      Joint order MUST match safe_configuration in solo12.yaml:
        [FL_HAA, FL_HFE, FL_KFE,
         FR_HAA, FR_HFE, FR_KFE,
         HL_HAA, HL_HFE, HL_KFE,
         HR_HAA, HR_HFE, HR_KFE]
    -->
    <xacro:if value="${simulation}">
      <xacro:unless value="${event_based_sim}">
        <gazebo>
          <plugin name="odri_gazebo" filename="libodri_gazebo_plugin.so">

            <joint name="FL_HAA"><param name="safe_position"> 0.0</param><param name="safe_torque">0.5</param></joint>
            <joint name="FL_HFE"><param name="safe_position"> 0.8</param><param name="safe_torque">0.5</param></joint>
            <joint name="FL_KFE"><param name="safe_position">-1.6</param><param name="safe_torque">0.5</param></joint>

            <joint name="FR_HAA"><param name="safe_position"> 0.0</param><param name="safe_torque">0.5</param></joint>
            <joint name="FR_HFE"><param name="safe_position"> 0.8</param><param name="safe_torque">0.5</param></joint>
            <joint name="FR_KFE"><param name="safe_position">-1.6</param><param name="safe_torque">0.5</param></joint>

            <joint name="HL_HAA"><param name="safe_position"> 0.0</param><param name="safe_torque">0.5</param></joint>
            <joint name="HL_HFE"><param name="safe_position">-0.8</param><param name="safe_torque">0.5</param></joint>
            <joint name="HL_KFE"><param name="safe_position"> 1.6</param><param name="safe_torque">0.5</param></joint>

            <joint name="HR_HAA"><param name="safe_position"> 0.0</param><param name="safe_torque">0.5</param></joint>
            <joint name="HR_HFE"><param name="safe_position">-0.8</param><param name="safe_torque">0.5</param></joint>
            <joint name="HR_KFE"><param name="safe_position"> 1.6</param><param name="safe_torque">0.5</param></joint>

          </plugin>
        </gazebo>
      </xacro:unless>
    </xacro:if>

  </xacro:macro>

</robot>
